//transaction generation

FUNCTION NOT AN EVENT

global current_time;
peer-> runtxn()
-   -> sample time exponential distribution whose mean time(Ttx)
-   -> createTxnEvent(Ttx);
;    -> push in the event queue in simulation

peer->create_transactionObj()
     -> generate random peerID and amount
     -> check amount <= my balance
     -> txn = create transaction object
     -> peer->transaction_pool.push_back(txn)
     -> broadcast(txn)


peer->broadcast(txn){
    get creator of txn
    iterate over its neigh
    {
        get delay from link data
        create receivetxnEvent(txn , neigh , delay)
        push in the event queue
    }
}

peer -> on_receive_block(blk*)
     -> check if block is valid
     -> add block to the parent
     -> update balance of peers

peer -> adj_peers

peer -> maintains all sent transactions   <txn , vector<peer*>>


//block generation
peer->runblk()
{
    while not simulation end
    {
        -> prevTipID
        blk = create_block(vector of txns , miner , prevTipID , timestamp)
        -> NewTipID
        -> if (prevTipID != NewTipID){
                iterate over block 
                ->add its transaction to txn pool
                continue;
           }
        -> if(size of blk > MAX_SIZE){
                continue;
           }
        -> wait for Tk ~ exp(I / hk)
        -> createblkEvent(blk);
        -> peer->blockchain->tip->child.push_back(block)
        -> peer->balance[peer->id] += reward
    }
}


createblkEvent(*blk)
{
    run() ->  get the miner id of the blk
                use the map to get the miner object
                get adjacent peers of the miner
                for each of the adj_peer{
                    delay = get the link data from (peer + adj_peer);
                    create receiveblkEvent(*blk , adj_peer , delay);
                    push in the event queue
                }
}

receiveblkEvent(blk , recvdBy , delay)
{
    //runs when delay = 0
    //adds blk to the parent id in the blockchain of curr
    run() ->  recvdBy->on_receive_block(*blk)
              for each of the neigh of recvdBy{
                  if (neigh never sent this blk to recvdBy) // recvdBy->sentBlk[blk].find(recvdBy) == recvdBy->sentBlk[txn].end()
                  and (recvdBy never sent this blk to neigh) //recvdBy->sentBlk[blk].find(neigh) == recvdBy->sentBlk[txn].end()
                 {     
                       recvdBy->sentBlk[blk].push_back(neigh);
                       get the link data from (recvdBy + neigh);
                       receivetxnEvent(*blk , neigh , delay);
                 }
              }
              
              
}

createtxnEvent(Ttx, peer* creator)
  {
    time_exec = Ttx + current_time;

    run()->{
        // the time counter must have already been updated to the event_time;
        creator->create_transactionObj();        
    }
  }

receivetxnEvent(*txn , recvdBy , delay)
{
 // runs when delay = 0
   run()  ->  recvdBy->on_receive_transaction(*txn);
             for each of the neigh of recvdBy{
                 if (neigh never sent this txn to recvdBy) // neigh->sentTxn[txn].find(recvdBy) == neigh->sentTxn[txn].end()
                  and (recvdBy never sent this txn to neigh) //recvdBy->sentTxn[txn].find(neigh) == recvdBy->sentTxn[txn].end()
                 {     
                       recvdBy->sentTxn[txn].push_back(neigh);
                       get the link data from (recvdBy + neigh);
                       receivetxnEvent(*txn , neigh , delay);
                 }
             }
}         




