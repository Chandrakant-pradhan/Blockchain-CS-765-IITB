//simulation

current_time;
priority_queue<event , comp>pq
while(not end){
    get top of the event
    current_time = event->time;
    event->run();
}

//event
class Event{
    run();
}

class createTxnEvent : public Event{
    run(){
        time badh chuka hai;
        ab perr ko bolo ki txn banae;
        peer->create_transaction();
        }
    createTxnEvent(t){
        event(current_time + t);
        push in the pq;
    }
}


//peer

class peer{

    activate(){
        generateTxn();
    }
    //response to event
    generateTxn(){ //caller => sim
        random time t;
        createTxnEvent(t)
    }
    
    create_transaction(){
        //create txn
        choose receiver amount;

        //add to txn pool      
        txn_pool.add(txn);
        generateTxn();
        broadcast(txn);

    }
    broadcast(txn){
        //send txn to all adj peers
        for all neighbors{
            receivetxnEvent(txn , neighbor , delay);
        }        
    }

    on_receive_transaction(txn*){
        //add to txn pool
    }
}


